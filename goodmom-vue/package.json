{
  "name": "@goodmom/vue",
  "version": "0.1.0",
  "description": "妈咪好 GoodMom 玻璃液态视觉规范 Vue 3 组件库（零基座自研 SFC + 设计 Token）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "//files": "playground/ 与截图不进包，仅本地验收用",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "build:js": "vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "goodmom",
    "glassmorphism"
  ],
  "license": "MIT",
  "author": "妈咪好 GoodMom Design System",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningmengsixiang/GoodMom.git",
    "directory": "goodmom-vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
